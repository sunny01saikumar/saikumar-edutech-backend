# NEXUS AI Environment Configuration

# Primary AI Provider Selection
# Options: openai | anthropic | gemini | ollama | openai-compatible | auto
AI_PROVIDER=gemini

# 1. Google Gemini Configuration (FREE API KEY available at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# 2. Ollama Local AI Configuration (100% Local Inference at https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 3. OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 4. Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 5. Generic OpenAI-Compatible Server (LM Studio, vLLM, LocalAI)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=local-model
